# Copie para .env e preencha. Nunca faça commit do .env.

# Postgres usado pelo worker e pelas migrations.
# No Supabase, use a string do pooler (porta 6543) para Vercel/Actions; prepared statements são desligados automaticamente.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/verificabr

# Postgres administrativo para os testes de integração (cria e apaga bancos temporários).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Provedor de IA do worker. Suportado: "gemini" (Google AI Studio).
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
# Chave criada em https://aistudio.google.com — nunca faça commit dela.
GEMINI_API_KEY=

# Tabela de preços em USD por milhão de tokens, copiada da página oficial do fornecedor.
# Sem preço para o modelo, o worker se recusa a usar um provedor real.
# Exemplo de formato (valores fictícios): {"modelo-x":{"inputPerMTok":0,"outputPerMTok":0}}
# Faixa gratuita do Gemini: preço 0 informado explicitamente.
AI_PRICING_JSON={"gemini-3.8-flash":{"inputPerMTok":0,"outputPerMTok":0}}

# Quantidade máxima de jobs processados por execução do worker.
WORKER_MAX_JOBS=5

# ---- Painel web (apps/web) ----
# Pessoas com acesso ao painel. Gere o hash com: pnpm --filter @verifica-br/web hash-password
# Formato: [{"id":"seu-usuario","name":"Seu Nome","passwordHash":"scrypt$..."}]
ADMIN_USERS=
# Segredo para assinar a sessão (mínimo 32 caracteres aleatórios), ex.: openssl rand -hex 32
SESSION_SECRET=
